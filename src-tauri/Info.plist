<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Merged into the generated Info.plist by the Tauri bundler.

	  CFBundleIconName points at the "AppIcon" entry inside Resources/Assets.car,
	  which is compiled from AppIcon.icon by scripts/generate-icons.sh. macOS 26
	  reads this key and renders the layered Liquid Glass icon.

	  Older macOS ignores it and falls back to CFBundleIconFile, which Tauri sets
	  to icons/icon.icns — the flat, HIG-margined icon. Both are required.
	-->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
</dict>
</plist>
