{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanger AI",
  "version": "1.0.2",
  "identifier": "com.rkarthik.hanger",
  "mainBinaryName": "Hanger AI",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:8397",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hanger AI",
        "width": 1024,
        "height": 700,
        "minWidth": 860,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3OTU5NDg4RTM1MDQwMTMKUldRVFFGRGppSlNWWjQ2NVcwYndXZmN2WGhleFJKbFRTUjdlaml5K1kwM1c4TEJKZkxCWmo3d3oK",
      "endpoints": [
        "https://github.com/k97/hanger-ai/releases/latest/download/latest.json"
      ]
    }
  }
}
