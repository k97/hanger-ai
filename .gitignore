# Local-only: isolated worktrees for subagent-driven plan execution
.worktrees/

# Local-only: the v3 prototype references. Five standalone HTML mockups, a
# 140-file vendor app-icon library and a set of full-size UI screenshots —
# 6.6 MB that the app does not build from and nothing imports. It stays on
# disk because it is what the redesign was drawn against; it stays out of
# history because git keeps binaries forever, including after a delete.
docs/v3-prototype-references/

# Local-only: the Tauri updater manifest, regenerated by each release. A
# tracked copy is a copy that is one release stale.
latest.json

# Local-only: per-machine Claude Code settings. `settings.json` is the shared
# file and `settings.local.json` is the private one; this repo's permissions
# and default mode are a personal choice, so they live in the latter.
.claude/settings.local.json
